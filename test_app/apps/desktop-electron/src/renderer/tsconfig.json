{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "types": ["vite/client"],
    "paths": {
      "@payloadcms/ui": ["./form/ui-shim/index.ts"]
    },
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["./**/*"]
}
